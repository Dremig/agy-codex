#!/usr/bin/env bash
set -euo pipefail

CPA_DIR="${AGY_CPA_DIR:-${HOME}/.cli-proxy-api}"
CPA_BIN="${CPA_DIR}/cli-proxy-api"
CPA_CFG="${CPA_DIR}/config.yaml"
CPA_LOG="${CPA_DIR}/proxy.log"
CPA_PID_FILE="${CPA_DIR}/proxy.pid"
CPA_CATALOG="${HOME}/.codex/agy-model-catalog.json"
CPA_HOST="${AGY_PROXY_HOST:-127.0.0.1}"
CPA_PORT="${AGY_PROXY_PORT:-8317}"
CPA_API_KEY="${AGY_PROXY_API_KEY:-sk-agy-local}"
CPA_BASE_URL="http://${CPA_HOST}:${CPA_PORT}/v1"
DEFAULT_MODEL="${AGY_MODEL:-gemini-4-argon}"
DEFAULT_EFFORT="${AGY_EFFORT:-}"

# Resolve repository root if invoked via symlink
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
  DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
REPO_ROOT="$(cd -P "$(dirname "${SOURCE}")/.." && pwd)"

is_proxy_running() {
  curl -fsS -m 1 "${CPA_BASE_URL}/models" -H "Authorization: Bearer ${CPA_API_KEY}" >/dev/null 2>&1
}

has_antigravity_auth() {
  compgen -G "${CPA_DIR}/antigravity-*.json" >/dev/null 2>&1 || compgen -G "${CPA_DIR}/*antigravity*.json" >/dev/null 2>&1
}

ensure_binary() {
  if [[ ! -x "${CPA_BIN}" ]]; then
    if [[ -x "${REPO_ROOT}/install.sh" ]]; then
      echo "📦 未检测到 cli-proxy-api 二进制，正在通过 install.sh 自动安装..."
      "${REPO_ROOT}/install.sh"
    else
      echo "❌ 未找到 ${CPA_BIN}，请先运行 ./install.sh" >&2
      exit 1
    fi
  fi
}

ensure_login() {
  ensure_binary
  if ! has_antigravity_auth; then
    echo "🔑 未检测到 Antigravity 授权凭证，正在启动首次 OAuth 登录..."
    "${CPA_BIN}" -config "${CPA_CFG}" -antigravity-login
  fi
}

sanitize_codex_auth() {
  local auth_file="${HOME}/.codex/auth.json"
  if [[ -f "${auth_file}" ]]; then
    python3 -c '
import json, os, shutil, sys
p, api_key = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(p))
except Exception:
    sys.exit(0)
if data.get("auth_mode") == "chatgpt" or not data.get("OPENAI_API_KEY"):
    bak = p + ".chatgpt.bak"
    if not os.path.exists(bak):
        shutil.copy2(p, bak)
    with open(p, "w") as f:
        json.dump({"OPENAI_API_KEY": api_key}, f)
    os.chmod(p, 0o600)
' "${auth_file}" "${CPA_API_KEY}" || true
  fi
}

sync_codex_catalog() {
  python3 -c '
import copy, json, os, sys

out_path = sys.argv[1]
cc_catalog = os.path.expanduser("~/.codex/cc-switch-model-catalog.json")
codex_cache = os.path.expanduser("~/.codex/models_cache.json")

template = None
for src in (cc_catalog, codex_cache):
    if os.path.exists(src):
        try:
            data = json.load(open(src))
            models = data.get("models", [])
            if models:
                template = models[0]
                break
        except Exception:
            pass

if template is None:
    sys.exit(0)

clean_instructions = (
    "You are a coding agent running in the Codex CLI, a terminal-based coding assistant. "
    "Collaborate with the user to solve their software engineering tasks accurately and efficiently."
)

models_spec = [
    ("gemini-4-argon", "Gemini 4 Argon", "Google Gemini 4 Argon via Antigravity", 1000000, "high", ["low", "medium", "high"]),
    ("gemini-3.8-flash", "Gemini 3.8 Flash", "Google Gemini 3.8 Flash via Antigravity", 1000000, "high", ["low", "medium", "high"]),
    ("claude-sonnet-4-6", "Claude Sonnet 4.6", "Anthropic Claude Sonnet 4.6 (Thinking) via Antigravity", 200000, "high", ["low", "medium", "high"]),
    ("claude-opus-4-6", "Claude Opus 4.6", "Anthropic Claude Opus 4.6 (Thinking) via Antigravity", 200000, "high", ["low", "medium", "high"]),
    ("gpt-oss-120b", "GPT-OSS 120B", "GPT-OSS 120B via Antigravity", 128000, "medium", ["low", "medium", "high"]),
    ("gemini-3-flash", "Gemini 3 Flash", "Google Gemini 3 Flash via Antigravity", 1000000, "medium", ["low", "medium", "high"]),
    ("gemini-3.5-flash-lite", "Gemini 3.5 Flash Lite", "Google Gemini 3.5 Flash Lite via Antigravity", 1000000, "low", ["low", "medium", "high"]),
]

effort_descriptions = {
    "low": "Fast responses with lighter reasoning",
    "medium": "Balances speed and reasoning depth for everyday tasks",
    "high": "Greater reasoning depth for complex problems",
}

out_models = []
for idx, (slug, display_name, desc, ctx, def_effort, efforts) in enumerate(models_spec):
    m = copy.deepcopy(template)
    m["slug"] = slug
    m["display_name"] = display_name
    m["description"] = desc
    m["base_instructions"] = clean_instructions
    m["model_messages"] = None
    m["apply_patch_tool_type"] = None
    m["support_verbosity"] = False
    m["supports_search_tool"] = False
    m["context_window"] = ctx
    m["max_context_window"] = ctx
    m["default_reasoning_level"] = def_effort
    m["supported_reasoning_levels"] = [
        {"effort": e, "description": effort_descriptions[e]} for e in efforts
    ]
    m["priority"] = 1000 - idx
    m["visibility"] = "list"
    out_models.append(m)

os.makedirs(os.path.dirname(out_path), exist_ok=True)
tmp_path = out_path + ".tmp"
with open(tmp_path, "w") as f:
    json.dump({"models": out_models}, f, ensure_ascii=False, indent=2)
os.replace(tmp_path, out_path)
' "${CPA_CATALOG}" || true
}

start_proxy() {
  ensure_login
  if is_proxy_running; then
    return 0
  fi

  echo "🚀 正在后台启动 Antigravity 转发服务 (${CPA_BASE_URL})..."
  nohup "${CPA_BIN}" -config "${CPA_CFG}" >>"${CPA_LOG}" 2>&1 &
  local pid=$!
  echo "${pid}" >"${CPA_PID_FILE}"

  for _ in {1..25}; do
    if is_proxy_running; then
      echo "✅ 转发服务已就绪 (PID: ${pid}, Endpoint: ${CPA_BASE_URL})"
      return 0
    fi
    sleep 0.2
  done

  echo "❌ 转发服务启动超时，请使用 'agy-codex logs' 查看日志 (${CPA_LOG})" >&2
  return 1
}

stop_proxy() {
  if [[ -f "${CPA_PID_FILE}" ]]; then
    local pid
    pid=$(cat "${CPA_PID_FILE}" 2>/dev/null || true)
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      kill "${pid}" 2>/dev/null || true
    fi
    rm -f "${CPA_PID_FILE}"
  fi
  pkill -f "${CPA_BIN} -config ${CPA_CFG}" 2>/dev/null || true
  echo "🛑 Antigravity 转发服务已停止。"
}

list_models() {
  curl -fsS "${CPA_BASE_URL}/models" -H "Authorization: Bearer ${CPA_API_KEY}" \
    | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin).get("data", [])
    if not data:
        print("  (暂无可用模型，请确认已执行 agy-codex login)")
    for m in data:
        mid = m.get("id", "")
        owner = m.get("owned_by", "")
        print(f"  - {mid}" + (f" ({owner})" if owner else ""))
except Exception as e:
    print(f"  解析模型列表失败: {e}")
'
}

pick_model() {
  local preferred="$1"
  local resolved
  resolved=$(curl -fsS "${CPA_BASE_URL}/models" -H "Authorization: Bearer ${CPA_API_KEY}" 2>/dev/null \
    | python3 -c '
import json, sys
preferred = sys.argv[1]
try:
    ids = [m.get("id") for m in json.load(sys.stdin).get("data", []) if m.get("id")]
    if preferred in ids:
        print(preferred)
    else:
        for cand in ["gemini-4-argon", "gemini-4-argon-high", "claude-sonnet-4-6", "claude-opus-4-6", "gemini-3.8-flash"]:
            if cand in ids:
                print(cand)
                break
        else:
            print(ids[0] if ids else preferred)
except Exception:
    print(preferred)
' "${preferred}")
  echo "${resolved:-${preferred}}"
}

show_status() {
  echo "=== agy-codex 状态 ==="
  if has_antigravity_auth; then
    echo "🔐 OAuth 凭证: 已配置 ($(ls -1 "${CPA_DIR}"/*antigravity*.json 2>/dev/null | xargs -n1 basename | paste -sd ', ' -))"
  else
    echo "🔐 OAuth 凭证: 未配置 (请运行 'agy-codex login')"
  fi

  if is_proxy_running; then
    echo "🟢 转发服务: 运行中 (${CPA_BASE_URL})"
    echo "📦 可用模型 (均支持在 Codex /model 中切换 low/medium/high 推理强度):"
    list_models
  else
    echo "⚪ 转发服务: 未运行 (可运行 'agy-codex start' 或直接运行 'agy-codex')"
  fi
}

show_help() {
  cat <<EOF
用法:
  agy-codex [codex 参数...]   自动确保转发启动，并直连 Antigravity 启动 Codex CLI
  agy-codex start | proxy     仅在后台启动 Antigravity 转发服务 (${CPA_BASE_URL})，供 cc-switch / Codex Desktop 使用
  agy-codex stop              停止后台转发服务
  agy-codex restart           重启后台转发服务
  agy-codex status            查看转发状态、授权账号与可用模型列表
  agy-codex login             登录或添加 Antigravity OAuth 账号
  agy-codex models            列出当前转发暴露的模型 ID
  agy-codex cc-switch         将 Antigravity (AGY) 供应商注入/同步至 CC Switch
  agy-codex logs              查看转发服务日志 (${CPA_LOG})

环境变量:
  AGY_MODEL=<model_id>        指定默认模型 (默认: ${DEFAULT_MODEL}，进入后可通过 /model 切换模型与 low/medium/high)
  AGY_EFFORT=<low|medium|high> 指定初始推理强度 (默认跟随模型预设，也可在 Codex 内用 /model 随时切换)
  AGY_PROXY_PORT=<port>       指定本地转发端口 (默认: ${CPA_PORT})
  AGY_PROXY_API_KEY=<key>     指定本地转发认证 Key (默认: ${CPA_API_KEY})
EOF
}

case "${1:-}" in
  start|proxy)
    start_proxy
    sync_codex_catalog
    show_status
    exit 0
    ;;
  stop)
    stop_proxy
    exit 0
    ;;
  restart)
    stop_proxy
    start_proxy
    sync_codex_catalog
    show_status
    exit 0
    ;;
  status)
    show_status
    exit 0
    ;;
  login)
    ensure_binary
    "${CPA_BIN}" -config "${CPA_CFG}" -antigravity-login
    exit 0
    ;;
  models)
    start_proxy
    echo "📦 当前可用模型 (${CPA_BASE_URL}/models):"
    list_models
    exit 0
    ;;
  cc-switch)
    shift
    python3 "${REPO_ROOT}/scripts/register-cc-switch.py" \
      --base-url "${CPA_BASE_URL}" \
      --api-key "${CPA_API_KEY}" \
      --default-model "${DEFAULT_MODEL}" \
      "$@"
    exit 0
    ;;
  logs)
    tail -n 100 -f "${CPA_LOG}"
    exit 0
    ;;
  -h|--help|help)
    show_help
    exit 0
    ;;
esac

# 默认行为：确保后台转发已启动，同步模型目录，清理失效 ChatGPT OAuth 残留，然后拉起 codex
start_proxy
sanitize_codex_auth
sync_codex_catalog

HAS_MODEL_ARG=0
for arg in "$@"; do
  if [[ "${arg}" == "-m" || "${arg}" == "--model" || "${arg}" == --model=* ]]; then
    HAS_MODEL_ARG=1
    break
  fi
done

CODEX_OVERRIDES=(
  --disable remote_plugin
  -c 'model_provider="agy"'
  -c 'model_providers.agy.name="Antigravity"'
  -c "model_providers.agy.base_url=\"${CPA_BASE_URL}\""
  -c 'model_providers.agy.wire_api="responses"'
  -c "model_providers.agy.experimental_bearer_token=\"${CPA_API_KEY}\""
  -c 'model_providers.agy.requires_openai_auth=false'
)

if [[ -f "${CPA_CATALOG}" ]]; then
  CODEX_OVERRIDES+=(-c "model_catalog_json=\"${CPA_CATALOG}\"")
fi

if [[ -n "${DEFAULT_EFFORT}" ]]; then
  CODEX_OVERRIDES+=(-c "model_reasoning_effort=\"${DEFAULT_EFFORT}\"")
fi

if [[ "${HAS_MODEL_ARG}" -eq 0 ]]; then
  SELECTED_MODEL=$(pick_model "${DEFAULT_MODEL}")
  CODEX_OVERRIDES+=(-c "model=\"${SELECTED_MODEL}\"")
  echo "🎯 启动 Codex (Provider: Antigravity, Model: ${SELECTED_MODEL} — 输入 /model 可切换模型及 low/medium/high 强度)"
else
  echo "🎯 启动 Codex (Provider: Antigravity — 输入 /model 可切换模型及 low/medium/high 强度)"
fi

exec codex "${CODEX_OVERRIDES[@]}" "$@"
